<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>promochaos: Third-Party Licences</title>
<style>
:root{--ink:#0b1220;--muted:#4a5565;--rule:#e3e6eb;--surface:#f6f7f9;--ground:#ffffff;--blue:#0065FD;color-scheme:light}
@media (prefers-color-scheme:dark){:root{--ink:#e3e6eb;--muted:#a3adbb;--rule:#263044;--surface:#121a2b;--ground:#0b1220;--blue:#5b9bff;color-scheme:dark}}
body{margin:0;background:var(--ground);color:var(--ink);font-family:ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;font-size:15px;line-height:22px}
main{max-width:960px;margin:0 auto;padding:40px 24px 64px}
h1{margin:0 0 8px;font-size:28px;line-height:36px;font-weight:600}
h2{margin:40px 0 8px;font-size:18px;line-height:24px;font-weight:600;border-top:1px solid var(--rule);padding-top:24px}
p{margin:0 0 12px;color:var(--muted);max-width:720px}
a{color:var(--blue)}
ul{margin:0 0 12px;padding-left:20px}
ul.used{columns:2 260px;font-size:13px;line-height:20px}
pre{margin:12px 0 0;padding:12px;background:var(--surface);border-radius:4px;font-family:ui-monospace,Consolas,monospace;font-size:12px;line-height:18px;white-space:pre-wrap;overflow-wrap:anywhere}
</style>
</head>
<body>
<main>
<h1>Third-Party Licences</h1>
<p>promochaos is licensed under the Apache License 2.0 (see LICENSE and NOTICE). The release binary includes the Rust crates below, each under its own licence. This file is generated by cargo-about from Cargo.lock; do not edit it by hand.</p>
<h2>Overview</h2>
<ul>
{{#each overview}}<li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
{{/each}}</ul>
{{#each licenses}}
<h2 id="{{id}}">{{name}}</h2>
<p>Used by:</p>
<ul class="used">
{{#each used_by}}<li>{{crate.name}} {{crate.version}}</li>
{{/each}}</ul>
<pre>{{text}}</pre>
{{/each}}
</main>
</body>
</html>
