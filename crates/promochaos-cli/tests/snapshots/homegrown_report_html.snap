*{box-sizing:border-box}
body{margin:0;background:var(--ground);color:var(--ink);font-family:Geist,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;font-size:15px;line-height:22px;font-variant-numeric:tabular-nums}
