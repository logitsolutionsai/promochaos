.ledger .row.total{padding-top:8px;border-top:1px solid var(--rule);font-weight:600}
.ledger .row.expected{color:var(--fail);font-weight:600}
.replay{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;padding:10px 12px 10px 16px;border:1px solid var(--code-rule);border-radius:4px;background:var(--code-bg);color:var(--code-ink);font-family:"Geist Mono",ui-monospace,Consolas,monospace;font-size:13px;line-height:20px;max-width:820px}
.replay .cmd{min-width:0;padding-top:6px;white-space:pre-wrap;overflow-wrap:anywhere}
.replay .ps{color:var(--code-muted);user-select:none}
.replay button{flex:0 0 auto;min-height:32px;padding:0 12px;border:1px solid var(--code-rule);border-radius:4px;background:transparent;color:var(--code-ink);font:500 12px/1 Geist,ui-sans-serif,system-ui,sans-serif;cursor:pointer}
.replay button:hover{border-color:var(--code-muted)}
.tablebox{overflow-x:auto;border-top:1px solid var(--rule)}
table.rules{width:100%;min-width:720px;font-size:13px;line-height:18px}
table.rules th,table.rules td{padding:10px 12px}
table.rules td.r,table.rules th.r{text-align:right}
table.rules td.why{color:var(--muted)}
.nc{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(300px,100%),1fr));gap:24px 40px;border-top:1px solid var(--rule);padding-top:16px}
.nc div{display:flex;flex-direction:column;gap:6px}
.nc h3{font-size:15px;line-height:22px}
.nc p{margin:0;font-size:14px;line-height:20px;color:var(--muted);text-wrap:pretty}
.notes{margin:0;padding-left:18px;font-size:13px;line-height:18px;color:var(--muted)}
footer.bottom{border-top:1px solid var(--rule)}
footer.bottom .wrap{padding-top:20px;padding-bottom:32px;display:flex;flex-wrap:wrap;justify-content:space-between;gap:8px 24px;font-size:13px;line-height:18px;color:var(--muted)}
@media (max-width:560px){.wrap{padding-left:16px;padding-right:16px}.facts{grid-template-columns:1fr;gap:2px 0}.facts .k:not(:first-child){margin-top:10px}.fcount{margin-left:0}svg.chart{width:640px;max-width:none}}
